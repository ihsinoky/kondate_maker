# Notion Integration Configuration (Optional)
# 
# To enable Notion integration, copy this file to .env.local and fill in your values.
# If these variables are not set, the app will use the JSON candidate pool instead.
#
# ⚠️ SECURITY WARNING:
# VITE_ environment variables are exposed in the browser bundle!
# Only use this configuration for:
# - Development/demo purposes
# - Personal use with private repositories
# For production use, move Notion API calls to a backend/serverless function.
#
# See docs/notion/SETUP.md for detailed setup instructions.

# Notion Integration Token (from https://www.notion.so/my-integrations)
# WARNING: This token will be visible in the browser! Keep this secret!
VITE_NOTION_TOKEN=

# Recipes Data Source ID (from Notion database)
# Get this from: Database → ... menu → Manage data sources → Copy data source ID
VITE_NOTION_RECIPES_DATA_SOURCE_ID=

# Meal Logs Data Source ID (from Notion database)
# Get this from: Database → ... menu → Manage data sources → Copy data source ID
VITE_NOTION_MEAL_LOGS_DATA_SOURCE_ID=
