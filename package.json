{
  "name": "kondate_maker",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "test": "npm run test:main-ingredient && npm run test:weekly-state && npm run test:filter-behavior",
    "test:main-ingredient": "npx tsx src/lib/mainIngredientEstimator.test.ts",
    "test:weekly-state": "npx tsx src/lib/weeklyState.test.ts",
    "test:filter-behavior": "npx tsx src/lib/filterBehavior.test.ts",
    "merge:inbox": "npx tsx scripts/merge-inbox.ts",
    "test:merge-inbox": "npx tsx scripts/merge-inbox.test.ts",
    "test:merge-inbox:integration": "npx tsx scripts/merge-inbox.integration.test.ts"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.1"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "@vitejs/plugin-react": "^4.2.1",
    "eslint": "^8.55.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "tsx": "^4.21.0",
    "typescript": "^5.2.2",
    "vite": "^5.0.8"
  }
}
